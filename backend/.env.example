# Copy this file to ".env" in the same folder and fill in real values.
# NEVER commit the real ".env" file - it is already in .gitignore.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=reachai
DB_USER=root
DB_PASSWORD=changeme

# --- JWT ---
# Must be at least 32 bytes long for HMAC-SHA256 signing.
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_bytes

# --- Google OAuth2 ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- SMTP (Ethereal for testing: https://ethereal.email/create) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Worker tuning ---
WORKER_CONCURRENCY=5
MIN_DELAY_SECONDS=1

# --- AI personalization (optional) ---
# Set AI_ENABLED=true and provide a real key to turn on per-lead
# AI-generated subject/body personalization when scheduling a campaign.
AI_ENABLED=false
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions
